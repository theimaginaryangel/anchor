# ============================================
# Anchor — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it's gitignored.

# --- Microsoft Entra ID (Authentication) ---
# Get these from your Entra ID app registration:
# Azure Portal → App registrations → your app
AUTH_MICROSOFT_ENTRA_ID_ID=           # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=       # Client secret value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=       # https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000    # Your app's base URL
NEXTAUTH_SECRET=                       # Random string. Generate with: openssl rand -base64 32

# --- AWS (shared credentials for Textract, Bedrock, and S3) ---
AWS_ACCESS_KEY_ID=                     # IAM user access key
AWS_SECRET_ACCESS_KEY=                 # IAM user secret key
AWS_REGION=us-east-1                   # Must support both Textract and Bedrock

# --- AWS S3 (Document Storage) ---
S3_BUCKET_NAME=anchor-documents        # Create this bucket in your AWS account

# --- AWS Bedrock (Embeddings) ---
# Make sure Titan Embeddings G1 is enabled in your Bedrock console
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1

# --- Google Gemini (Answer Generation) ---
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase (Postgres + pgvector) ---
# Get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=              # https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=             # service_role key (keep secret, server-side only)
